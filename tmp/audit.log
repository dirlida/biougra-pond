#!/usr/bin/env python3
import json, pathlib, time, hashlib, os, shutil, fcntl, sys
from datetime import datetime, timezone
ROOT=pathlib.Path(".")
CHAIN=ROOT/"chain.json"
STATE=ROOT/"kernel/state/chain.json"
PUBLIC=ROOT/"embassy/public/chain.json"
LOG=ROOT/"attic/logs/pond.log"
LOCK=ROOT/"attic/pond.lock"
LAST=ROOT/"LAST.txt"
SHA=ROOT/"SHA256.txt"
INTERVAL=600
LOG.parent.mkdir(parents=True, exist_ok=True)

def log(msg):
    ts=datetime.now(timezone.utc).isoformat()
    line=f"[{ts}] {msg}"
    print(line)
    try:
        with open(LOG,"a") as f: f.write(line+"\n")
    except: pass

def atomic_write(path,data):
    p=pathlib.Path(path)
    tmp=p.with_suffix('.tmp')
    tmp.write_text(json.dumps(data,indent=2))
    tmp.rename(p)

def fork_guard_check(chain):
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    lf=open(LOCK,"w")
    try:
        fcntl.flock(lf, fcntl.LOCK_EX|fcntl.LOCK_NB)
    except:
        log("FORK_GUARD: another daemon running — ABORT")
        sys.exit(1)
    # REAL fork check: prev must match previous hash
    for i in range(1,len(chain)):
        if chain[i].get('prev') != chain[i-1].get('hash'):
            log(f"FORK_GUARD: BROKEN LINK at {i} {chain[i-1]['hash'][:12]} != prev {chain[i].get('prev','')[:12]} HALT")
            pathlib.Path("embassy/public/FORK_ALERT.md").write_text(f"BROKEN LINK at {i}\n")
            sys.exit(2)
    return lf

def load_chain():
    return json.loads(CHAIN.read_text()) if CHAIN.exists() else []

def save_chain(chain):
    # assert prev == tip before write (your request)
    for i in range(1,len(chain)):
        assert chain[i]['prev'] == chain[i-1]['hash'], f"FORK PREVENTED: prev != tip at {i}"
    # height collision: payload index or len check
    assert chain[-1]['prev'] == chain[-2]['hash'] if len(chain)>1 else True, "HEIGHT COLLISION"
    atomic_write(CHAIN, chain)
    shutil.copy(CHAIN, STATE)
    try: shutil.copy(CHAIN, PUBLIC)
    except: pass
    LAST.write_text(chain[-1]['hash']+"\n")
    SHA.write_text(f"{hashlib.sha256(CHAIN.read_bytes()).hexdigest()}  chain.json\n")

def mine_next(chain):
    from kernel.consensus.fork_guard import check
    check()
    last=chain[-1]
    prev=last['hash']
    height=len(chain)
    payload={"index":height,"timestamp":datetime.now(timezone.utc).isoformat(),"sun":15.2,"btc":972583}
    new_block={"hash":hashlib.sha256(f"{prev}{json.dumps(payload)}".encode()).hexdigest(),"prev":prev,"payload":payload}
    assert new_block['prev'] == chain[-1]['hash'], "FORK PREVENTED: prev != tip"
    assert new_block['payload']['index'] == len(chain), "HEIGHT COLLISION"
    chain.append(new_block)
    save_chain(chain)
    log(f"MINED {height} {new_block['hash'][:12]} prev={prev[:12]}")
    return new_block

def main():
    log("Pond daemon v4.3 FORK-SAFE OFFLINE PROOF - Biougra A13")
    while True:
        chain=load_chain()
        lf=fork_guard_check(chain)
        last_time=chain[-1]['payload'].get('timestamp') if isinstance(chain[-1].get('payload'),dict) else None
        try:
            age=(datetime.now(timezone.utc)-datetime.fromisoformat(last_time)).total_seconds() if last_time else 0
        except: age=0
        wait=max(0,INTERVAL-age)
        log(f"on-time {len(chain)-1} {int(age)}s ago wait {int(wait)}s")
        if wait<5:
            try: mine_next(chain)
            except AssertionError as e: log(f"FORK BLOCKED: {e}")
            except Exception as e: log(f"mine error {e}")
        try: fcntl.flock(lf,fcntl.LOCK_UN); lf.close()
        except: pass
        time.sleep(30)

if __name__=="__main__": main()

